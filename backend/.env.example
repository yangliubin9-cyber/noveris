# Copy to .env before starting. Generate a long random SECRET_KEY for production.
DATABASE_URL=sqlite:///./noveris.db
SECRET_KEY=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional absolute path to a built frontend/dist directory for single-origin hosting.
FRONTEND_DIST=
# Used by deploy/noveris.service; bind to the intended server interface.
BIND_HOST=127.0.0.1
BIND_PORT=24080
COOKIE_SECURE=0
DEMO_MODE=1
# Set to 1 only for local inference services on this computer.
ALLOW_LOOPBACK_UPSTREAMS=0
# Absolute path to an OpenSSH known_hosts file with fingerprints verified out of band.
# Required for SSH checks using stored node credentials. Never auto-trust a first connection.
SSH_KNOWN_HOSTS=

# Password reset email. Without SMTP, reset tokens appear only in DEMO_MODE=1.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Optional OIDC authorization-code SSO. All three are needed to enable it.
# Configure the IdP callback URL as http://localhost:8000/api/auth/oidc/callback.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Enterprise SSO
